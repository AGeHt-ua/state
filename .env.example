# Скопіюйте цей файл як .env у корінь сервера на SparkedHost і впишіть значення.
# .env НІКОЛИ не потрапляє в git.

# Токен бота: discord.com/developers → ваш застосунок → Bot → Reset Token
DISCORD_TOKEN=

# ID сервера СБУ (ПКМ по серверу → Копіювати ID). Можна не вказувати, якщо бот лише на одному сервері.
GUILD_ID=

# Сайт, якому дозволено звертатися до бота (через кому)
SITE_ORIGINS=https://ageht-ua.github.io
SITE_URL=https://ageht-ua.github.io/state/

# Необов'язково
# BACKUP_EVERY_HOURS=6
# BACKUP_KEEP_DAYS=30
# MAX_UPLOAD_MB=10
