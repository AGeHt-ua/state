# Скопіюйте цей файл як .env у корінь сервера на SparkedHost і впишіть значення.
# .env НІКОЛИ не потрапляє в git.

# Токен бота: discord.com/developers → ваш застосунок → Bot → Reset Token
DISCORD_TOKEN=

# ID сервера СБУ. За замовчуванням — «Служба Безпеки NG» (1553695043947077684).
GUILD_ID=

# Сайт, якому дозволено звертатися до бота (через кому)
SITE_ORIGINS=https://ageht-ua.github.io
SITE_URL=https://ageht-ua.github.io/state/

# Оголошення в CASTRO CONTROL: спільний ключ із сервером CASTRO (секрет SOVA_API_SECRET у його Worker).
# Будь-який довгий випадковий рядок (від 32 символів), однаковий в обох місцях.
CASTRO_API_SECRET=

# Необов'язково
# BACKUP_EVERY_HOURS=6
# BACKUP_KEEP_DAYS=30
# MAX_UPLOAD_MB=10
